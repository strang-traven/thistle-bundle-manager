# Never commit the real values. Set secrets with `fly secrets set`.
SHOPIFY_API_KEY=your-existing-bundle-app-client-id
SHOPIFY_API_SECRET=your-existing-bundle-app-client-secret
SHOPIFY_SHOP_DOMAIN=your-real-shop.myshopify.com
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=base64-encoded-32-random-bytes
DATABASE_URL=postgres://postgres:example@localhost:5432/thistle_bundles
SHOPIFY_API_VERSION=2026-10
PORT=8080
ENABLE_STOCK_MUTATIONS=false
